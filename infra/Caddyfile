{$SITE_ADDRESS} {
	# API and ops endpoints go to the single server process.
	@api path /api/* /healthz /readyz
	handle @api {
		reverse_proxy app:8000 {
			# Needed later for Server-Sent Events: never buffer responses.
			flush_interval -1
		}
	}
	# Everything else is the web app; unknown paths fall back to index.html (client routing).
	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
