# Copy to infra/.env (never commit .env).
# Local development: keep SITE_ADDRESS=localhost (Caddy makes a local certificate).
# On the server, bootstrap.sh writes this file for you.
SITE_ADDRESS=localhost
POSTGRES_PASSWORD=change-this
# Shared event password for rooms, and the admin password.
ROOM_PASSWORD=dev-room-pw
ADMIN_PASSWORD=dev-admin-pw
# Site name and icon: the tab title, the tab icon and the login page. Not hard-coded anywhere else.
# APP_ICON is a path from the site root (a file in web/public/, e.g. /logo.svg) or an https:// link.
# After the first change on the super-admin page (/super), the saved values win over these.
APP_NAME=Lemon
APP_ICON=/logo.png
# Super-admin page (/super): Google sign-in. See README "Super-admin page". Leave empty to turn it off.
# SUPER_ADMIN_EMAILS can always sign in and can't be removed on the page. Others are added there.
GOOGLE_CLIENT_ID=1017841796593-36c550q89d5sqtst13p2ufjf9076kkis.apps.googleusercontent.com
SUPER_ADMIN_EMAILS=iancheung@berkeley.edu,forrestchou@berkeley.edu
# Optional: SEED_ROOMS="Evans 10,Soda 306"  SESSION_DURATION_MIN=60
# (seed rooms are only used the first time, when the database has no rooms)
# ContestDojo roster sync (Admin > Roster > Sync). Both are required; redeploy after changing.
CONTESTDOJO_API_TOKEN=
CONTESTDOJO_EVENT_ID=
