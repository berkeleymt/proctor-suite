# Copy to infra/.env (never commit .env).
# Local development: keep SITE_ADDRESS=localhost (Caddy makes a local certificate).
# On the server, bootstrap.sh writes this file for you.
SITE_ADDRESS=localhost
POSTGRES_PASSWORD=dev-only-change-me
# Slice 1 (in-memory demo): shared event password for rooms, and the admin password.
ROOM_PASSWORD=dev-room-pw
ADMIN_PASSWORD=dev-admin-pw
# Optional: SEED_ROOMS="Evans 10,Soda 306"  SESSION_DURATION_MIN=60
