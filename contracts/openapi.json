      "TimerSnapshot": {
        "description": "The folded timer state (plan \u00a73.3).\n\nremaining(now) = max(0, duration_ms + adjust_total_ms - elapsed_banked_ms\n                        - (now - running_since_ms if RUNNING else 0))",
        "properties": {
          "adjust_total_ms": {
            "title": "Adjust Total Ms",
            "type": "integer"
          },
          "duration_ms": {
            "title": "Duration Ms",
            "type": "integer"
